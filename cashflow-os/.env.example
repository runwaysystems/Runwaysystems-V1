# Public storefront configuration. Copy to .env before running npm run dev.
# Never place provider secrets here. Vite compiles every VITE_ value into
# browser assets. Delivery and payment secrets stay in the Cloudflare Worker.

# Cloudflare Worker URL, e.g. https://platform.your-worker.workers.dev
VITE_API_BASE_URL=

# Public support address shown on the storefront
VITE_SUPPORT_EMAIL=hello@your-domain.com

# Public Supabase project values for Google OAuth.
# The anon key is public by design, but ONLY safe because this storefront
# never queries Supabase tables from the browser (auth only). If you ever
# add client-side data reads, Row Level Security MUST be enabled on every
# Supabase table first, or the anon key exposes the entire database.
# The service_role key must NEVER appear in a VITE_ variable or anywhere
# client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Owner account email used for the owner-only dashboard link. NOTE: VITE_
# values are compiled into the browser bundle, so this email is visible to
# anyone who inspects the JS. Prefer setting the owner role in Supabase
# app_metadata instead and leave this empty if you do not want the address
# published.
VITE_OWNER_EMAIL=

# Optional public Trustpilot values
VITE_TRUSTPILOT_REVIEW_URL=https://www.trustpilot.com/review/your-domain.com
VITE_TRUSTPILOT_BUSINESS_UNIT_ID=
